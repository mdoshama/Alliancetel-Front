# Serves the Angular app and forwards /api to the Spring Boot backend.
# Values in ${...} are filled in from the container environment when nginx starts:
#   PORT                   port to listen on (Railway sets this; 80 by default)
#   BACKEND_URL            where the API runs, e.g. http://backend.railway.internal:8080
#   NGINX_LOCAL_RESOLVERS  this container's DNS server(s), detected automatically
# Use the scheme Railway's edge saw (https) when present, otherwise our own.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Look the backend's address up again every 10 seconds. On Railway (and in Docker) a redeployed service gets a
    # new internal IP; without this nginx would keep using the old one and every API call would fail.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        # A variable makes nginx resolve the name per request (through the resolver above) instead of once at startup.
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Keeps the real visitor address (used to slow down password guessing) behind Railway's edge proxy.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        # The API sets its own security headers; replace them so each appears only once.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Build output has content hashes in file names, so it can be cached for a long time.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Angular routes (/schedules, /employees, ...) all load index.html, which must never be cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
