# Copy to keystore.properties (same folder) and fill in. keystore.properties and the .jks file are NOT committed.
# Create the upload key once (keep the file and passwords somewhere safe; you need them for every update):
#   keytool -genkeypair -v -keystore alliancetel-upload.jks -alias alliancetel -keyalg RSA -keysize 2048 -validity 10000
storeFile=alliancetel-upload.jks
storePassword=CHANGE_ME
keyAlias=alliancetel
keyPassword=CHANGE_ME
